{
  "name": "brabusfit",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@brabus/web",
    "dev:web": "turbo run dev --filter=@brabus/web",
    "dev:mobile": "npm run start --workspace=@brabus/mobile",
    "db:start": "npx supabase@3.3.0 start",
    "db:stop": "npx supabase@3.3.0 stop",
    "db:reset": "npx supabase@3.3.0 db reset",
    "local:web": "npm run dev:local --workspace=@brabus/web",
    "local:mobile": "npm run dev:local --workspace=@brabus/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:db": "turbo run test:db",
    "db:types": "npx supabase@3.3.0 gen types typescript --schema public > packages/shared/src/database.generated.ts && prettier --write packages/shared/src/database.generated.ts",
    "e2e": "npm run e2e --workspace=@brabus/web"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.1",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "vitest": "^5.1.0"
  },
  "packageManager": "npm@11.11.0"
}
