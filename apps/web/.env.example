# Supabase — obtené estos valores en el dashboard del proyecto (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role: SOLO en el servidor. Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — email transaccional (aviso "te compartieron una rutina")
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=Brabus Fit <no-reply@tudominio.com>

# URL pública de la app (para links en emails / OAuth redirect)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
