# Supabase: dashboard del proyecto → Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…): pública.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_…): SOLO en el servidor. Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Resend: email transaccional (opcional; hoy apagado hasta tener dominio propio).
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Brabus Fit <no-reply@tu-dominio.com>

# URL pública de la app (links en emails y redirect de OAuth).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
