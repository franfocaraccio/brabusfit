{
  "expo": {
    "name": "Brabus Fit",
    "slug": "brabus-fit",
    "scheme": "brabusfit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0e1116",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.brabusfit.mobile"
    },
    "android": {
      "package": "app.brabusfit.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0e1116",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0e1116",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-web-browser",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6f6c74e5-fc15-451d-9808-66cce2ea769d"
      }
    },
    "owner": "brabusfit-team",
    "updates": {
      "url": "https://u.expo.dev/6f6c74e5-fc15-451d-9808-66cce2ea769d"
    },
    "runtimeVersion": "exposdk:57.0.0"
  }
}
