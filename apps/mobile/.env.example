# Solo valores PÚBLICOS de Supabase (Settings → API Keys): las variables
# EXPO_PUBLIC_* quedan dentro de la app. Nunca poner la secret key acá.
EXPO_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…).
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Opcional: URL de la web (links a la versión web). Por defecto producción.
# EXPO_PUBLIC_WEB_URL=http://localhost:3000
